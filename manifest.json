      "js": [
        "data/defaultPrompts.js",
        "lib/theme.js",
        "lib/template.js",
        "lib/modifiers.js",
        "lib/promptStore.js",
        "content/adapters.js",
        "content/variableModal.js",
        "content/slashTrigger.js",
        "content/commandPalette.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-command-palette": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open the OmniPrompt command palette"
    }
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
